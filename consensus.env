# Kernel Source and config naming.
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=lineage-22.1
KERNEL_CONFIG=vendor/lineageos_pstar_consensus_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
EXTRA_CMDS:LD=ld.lld LOCALVERSION=22-consensus

# KernelSU flags
ENABLE_KERNELSU=true
KERNELSU_TAG=susfs-v1.5.5
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
SUSFS_VERSION=1.5.5
Kernel_Version=4.19
Kernel_Extra_Version=4.19.157


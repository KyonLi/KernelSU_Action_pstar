# Kernel Source and config naming.
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=
KERNEL_CONFIG=vendor/lineageos_pstar_standard_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
EXTRA_CMDS:LD=ld.lld

# KernelSU flags
ENABLE_KERNELSU=true
KERNELSU_TAG=next
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=
Kernel_Version=4.19
Kernel_Extra_Version=4.19.193


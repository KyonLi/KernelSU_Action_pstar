# Kernel Source and config naming.
KERNEL_SOURCE=https://github.com/crdroidandroid/android_kernel_motorola_sm8250
KERNEL_SOURCE_BRANCH=15.0
KERNEL_CONFIG=vendor/lineageos_pstar_suspended_defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=true
EXTRA_CMDS:LD=ld.lld LOCALVERSION=22-suspended

# KernelSU flags
ENABLE_KERNELSU=true
KERNELSU_TAG=next-susfs
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

